# Copy this file to .env before running docker compose.
# Do not commit real secrets.

# Web/API
WEB_PORT=5080
ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL / pgvector
POSTGRES_DB=mcp_gemini
POSTGRES_USER=mcp_user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_INITIALIZE_ON_STARTUP=true

# Gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2

# MCP request timeout
MCP_REQUEST_TIMEOUT_SECONDS=60

# RAG
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=text-embedding-004
RAG_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.72
RAG_MAX_CONTEXT_CHARS=6000
RAG_SEARCH_TIMEOUT_MS=1500
RAG_EMBEDDING_CACHE_MINUTES=30
RAG_EMBEDDING_FAILURE_COOLDOWN_SECONDS=60
RAG_INDEX_QUEUE_CAPACITY=1000

# Primavera P6 EPPM
P6_BASE_URL=https://primavera.iges.in:18206/p6ws/restapi
P6_AUTH_MODE=basic
P6_USERNAME=
P6_PASSWORD=
P6_AUTH_TOKEN=
P6_ACCESS_TOKEN=
P6_TOKEN_HEADER=AuthToken
P6_PROJECT_ENDPOINT=project
P6_ACTIVITY_ENDPOINT=activity
P6_WBS_ENDPOINT=wbs
P6_RELATIONSHIP_ENDPOINT=relationship
P6_RESOURCE_ASSIGNMENT_ENDPOINT=resourceAssignment
P6_FILTER_PARAM=Filter
P6_FIELDS_PARAM=Fields
P6_TIMEOUT_SECONDS=30
P6_VERIFY_SSL=true
