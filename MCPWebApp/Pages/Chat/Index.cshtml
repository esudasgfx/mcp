@page "/Chat"
@model MCPWebApp.Pages.Chat.IndexModel
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MCP Gemini Enterprise Chat</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: #f5f7fb;
        }

        .chat-log {
            height: 62vh;
            overflow-y: auto;
            background: #ffffff;
            border: 1px solid #dee2e6;
            border-radius: 0.75rem;
            padding: 1rem;
        }

        .message {
            border-radius: 0.75rem;
            padding: 0.75rem 1rem;
            margin-bottom: 0.75rem;
            white-space: pre-wrap;
        }

        .message-user {
            background: #e7f1ff;
            border: 1px solid #b6d4fe;
        }

        .message-ai {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
        }

        .message-error {
            background: #f8d7da;
            border: 1px solid #f1aeb5;
            color: #842029;
        }
    </style>
</head>
<body>
    <main class="container py-4">
        <div class="mb-4">
            <h1 class="h3 mb-1">MCP Gemini Enterprise Chat</h1>
            <p class="text-muted mb-0">
                Select an enterprise tool, provide parameters, and send the request to the standalone Python MCP server over stdio JSON-RPC.
            </p>
        </div>

        <div class="row g-4">
            <section class="col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="toolSelect" class="form-label">Enterprise Tool</label>
                            <select id="toolSelect" class="form-select">
                                <option value="">Loading tools...</option>
                            </select>
                            <div id="toolDescription" class="form-text"></div>
                        </div>

                        <div class="mb-3">
                            <label for="queryInput" class="form-label">Query</label>
                            <textarea id="queryInput" class="form-control" rows="3" placeholder="Ask Gemini what you need from this enterprise data."></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="parametersInput" class="form-label">Parameters JSON</label>
                            <textarea id="parametersInput" class="form-control font-monospace" rows="12" spellcheck="false"></textarea>
                            <div class="form-text">
                                The selected tool's required fields are pre-filled. The query textbox is copied into the JSON as <code>query</code> when you send.
                            </div>
                        </div>

                        <button id="sendButton" class="btn btn-primary w-100" type="button">
                            <span id="sendSpinner" class="spinner-border spinner-border-sm me-2 d-none" aria-hidden="true"></span>
                            Send
                        </button>
                    </div>
                </div>
            </section>

            <section class="col-lg-7">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h2 class="h5 mb-0">Conversation</h2>
                    <button id="clearButton" class="btn btn-sm btn-outline-secondary" type="button">Clear</button>
                </div>
                <div id="chatLog" class="chat-log shadow-sm">
                    <div class="message message-ai">
                        Choose a tool, enter parameters, and send a request. Responses are generated by Gemini through the Python MCP server.
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script>
        const toolSelect = document.getElementById("toolSelect");
        const toolDescription = document.getElementById("toolDescription");
        const queryInput = document.getElementById("queryInput");
        const parametersInput = document.getElementById("parametersInput");
        const sendButton = document.getElementById("sendButton");
        const sendSpinner = document.getElementById("sendSpinner");
        const clearButton = document.getElementById("clearButton");
        const chatLog = document.getElementById("chatLog");

        let tools = [];
        let currentSessionId = null;

        function appendMessage(kind, title, text) {
            const message = document.createElement("div");
            message.className = `message message-${kind}`;
            message.innerHTML = `<strong>${escapeHtml(title)}</strong>\n${escapeHtml(text)}`;
            chatLog.appendChild(message);
            chatLog.scrollTop = chatLog.scrollHeight;
        }

        function escapeHtml(value) {
            return String(value)
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll("\"", "&quot;")
                .replaceAll("'", "&#039;");
        }

        function defaultValueForProperty(name, schema) {
            if (name === "query") {
                return "";
            }

            if (schema?.default !== undefined) {
                return schema.default;
            }

            switch (schema?.type) {
                case "integer":
                case "number":
                    return 0;
                case "boolean":
                    return false;
                case "array":
                    return [];
                case "object":
                    return {};
                default:
                    if (name.includes("file_path")) {
                        return "/path/to/data.xlsx";
                    }
                    if (name.includes("project_id")) {
                        return "PROJECT-001";
                    }
                    if (name.includes("project_code")) {
                        return "P6-PROJECT-001";
                    }
                    if (name.includes("asset_id")) {
                        return "ASSET-001";
                    }
                    if (name.includes("shell_number")) {
                        return "SHELL-001";
                    }
                    if (name.includes("system_id")) {
                        return "S4HANA-DEV";
                    }
                    return "";
            }
        }

        function updateParametersForSelectedTool() {
            const selected = tools.find(tool => tool.name === toolSelect.value);
            if (!selected) {
                toolDescription.textContent = "";
                parametersInput.value = "{}";
                return;
            }

            toolDescription.textContent = selected.description || "";
            const schema = selected.inputSchema || selected.input_schema || {};
            const properties = schema.properties || {};
            const required = schema.required || Object.keys(properties);
            const defaults = {};

            for (const name of required) {
                if (name === "query") {
                    continue;
                }
                defaults[name] = defaultValueForProperty(name, properties[name]);
            }

            parametersInput.value = JSON.stringify(defaults, null, 2);
        }

        async function loadTools() {
            try {
                const response = await fetch("/api/chat/tools");
                const payload = await response.json();
                if (!response.ok) {
                    throw new Error(payload.error || "Unable to load tools.");
                }

                tools = payload;
                toolSelect.innerHTML = "";

                for (const tool of tools) {
                    const option = document.createElement("option");
                    option.value = tool.name;
                    option.textContent = `${tool.name} - ${tool.description || "No description"}`;
                    toolSelect.appendChild(option);
                }

                updateParametersForSelectedTool();
            } catch (error) {
                toolSelect.innerHTML = "<option value=\"\">Failed to load tools</option>";
                appendMessage("error", "Error", error.message);
            }
        }

        async function sendChat() {
            const toolName = toolSelect.value;
            if (!toolName) {
                appendMessage("error", "Validation", "Please select a tool.");
                return;
            }

            let parameters;
            try {
                parameters = JSON.parse(parametersInput.value || "{}");
            } catch {
                appendMessage("error", "Validation", "Parameters must be valid JSON.");
                return;
            }

            parameters.query = queryInput.value.trim();
            if (!parameters.query) {
                appendMessage("error", "Validation", "Please enter a query.");
                return;
            }

            appendMessage("user", `You via ${toolName}`, `${parameters.query}\n\nParameters:\n${JSON.stringify(parameters, null, 2)}`);
            sendButton.disabled = true;
            sendSpinner.classList.remove("d-none");

            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), 60000);

            try {
                const response = await fetch("/api/chat/send", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ sessionId: currentSessionId, toolName, parameters }),
                    signal: controller.signal
                });
                const payload = await response.json();
                if (payload.sessionId) {
                    currentSessionId = payload.sessionId;
                }

                if (!response.ok || !payload.success) {
                    throw new Error(payload.error || "The MCP server returned an error.");
                }

                appendMessage("ai", "Gemini", payload.content || "(empty response)");
            } catch (error) {
                const message = error.name === "AbortError"
                    ? "The request exceeded the 60-second timeout."
                    : error.message;
                appendMessage("error", "Error", message);
            } finally {
                clearTimeout(timeout);
                sendButton.disabled = false;
                sendSpinner.classList.add("d-none");
            }
        }

        toolSelect.addEventListener("change", updateParametersForSelectedTool);
        sendButton.addEventListener("click", sendChat);
        clearButton.addEventListener("click", () => {
            chatLog.innerHTML = "";
            currentSessionId = null;
        });

        loadTools();
    </script>
</body>
</html>
