{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MCPWebApp.Services.MCPClientService": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=mcp_gemini;Username=mcp_user;Password=change-me"
  },
  "Database": {
    "InitializeOnStartup": true
  },
  "MCP": {
    "PythonPath": "python",
    "ScriptPath": "../mcp_gemini_server/main.py",
    "RequestTimeoutSeconds": 60
  },
  "RAG": {
    "Enabled": true,
    "EmbeddingModel": "text-embedding-004",
    "EmbeddingDimensions": 768,
    "TopK": 5,
    "MinSimilarity": 0.72,
    "MaxContextChars": 6000,
    "GeminiApiBaseUrl": "https://generativelanguage.googleapis.com"
  },
  "P6": {
    "BaseUrl": "https://your-p6-host/p6ws/restapi"
  },
  "ACC": {
    "BaseUrl": "https://developer.api.autodesk.com"
  },
  "Unifier": {
    "BaseUrl": "https://your-unifier-host/ws/rest/service/v1"
  },
  "SAP": {
    "BaseUrl": "https://your-sap-host/sap/opu/odata/sap"
  },
  "EAM": {
    "BaseUrl": "https://your-eam-host/api"
  }
}
